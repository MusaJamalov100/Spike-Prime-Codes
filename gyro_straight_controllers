from spike import PrimeHub, MotorPair, Motor
from spike.control import wait_for_seconds

# ---------- Ports ----------
LEFT_MOTOR = 'A'
RIGHT_MOTOR = 'E'

# ---------- Settings ----------
DISTANCE = 720    # how far to drive, in motor degrees
SPEED = 40        # driving speed (-100 to 100)
KP = 2
KI = 0.01
KD = 2
DT = 0.02         # loop time in seconds

hub = PrimeHub()
motors = MotorPair(LEFT_MOTOR, RIGHT_MOTOR)
motor = Motor(LEFT_MOTOR)


def clamp(value, low=-100, high=100):
    return max(low, min(high, value))


# The robot must stand still while the gyro is reset
hub.motion_sensor.reset_yaw_angle()
motor.set_degrees_counted(0)

integral = 0
last_error = 0

while abs(motor.get_degrees_counted()) < DISTANCE:
    # error = how far the robot has turned away from the start direction
    error = 0 - hub.motion_sensor.get_yaw_angle()

    integral = clamp(integral + error, -500, 500)
    derivative = error - last_error
    last_error = error

    steering = clamp(int(KP * error + KI * integral + KD * derivative))
    # If the robot curves even more, change this to motors.start(-steering, SPEED)
    motors.start(steering, SPEED)

    wait_for_seconds(DT)

motors.stop()


# ===== VERSION 3: LQR =====


from spike import PrimeHub, MotorPair, Motor
from spike.control import wait_for_seconds

# ---------- Ports ----------
LEFT_MOTOR = 'A'
RIGHT_MOTOR = 'E'

# ---------- Settings ----------
DISTANCE = 720    # how far to drive, in motor degrees
SPEED = 40        # driving speed (-100 to 100)
DT = 0.02         # loop time in seconds

# LQR gains, calculated offline for a simple turning model
# (weights: heading error 1, turn rate 0.001, steering effort 0.25).
# These are a starting point: tune K1 and K2 on your robot.
# state = [heading error, turning rate]
# steering = K1 * heading error - K2 * turning rate
K1 = 2.0          # gain on the heading error (degrees)
K2 = 0.24         # gain on the turning rate (degrees per second)

hub = PrimeHub()
motors = MotorPair(LEFT_MOTOR, RIGHT_MOTOR)
motor = Motor(LEFT_MOTOR)


def clamp(value, low=-100, high=100):
    return max(low, min(high, value))


# The robot must stand still while the gyro is reset
hub.motion_sensor.reset_yaw_angle()
motor.set_degrees_counted(0)

last_yaw = 0

while abs(motor.get_degrees_counted()) < DISTANCE:
    yaw = hub.motion_sensor.get_yaw_angle()

    heading_error = 0 - yaw
    turn_rate = (yaw - last_yaw) / DT   # degrees per second
    last_yaw = yaw

    steering = clamp(int(K1 * heading_error - K2 * turn_rate))
    # If the robot curves even more, change this to motors.start(-steering, SPEED)
    motors.start(steering, SPEED)

    wait_for_seconds(DT)

motors.stop()
